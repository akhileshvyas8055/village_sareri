rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // News images: public read, write for authenticated admins or news migration
    match /news/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    // Gram Sabha documents
    match /gramSabha/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
