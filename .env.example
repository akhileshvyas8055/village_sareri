FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# Optional public Firebase Web Push key used by browser token registration.
VITE_FIREBASE_VAPID_KEY=your-public-vapid-key

# Configure the same random value in the Vercel project environment settings.
CRON_SECRET=generate-a-random-secret-of-at-least-16-characters
